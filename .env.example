# ================================================================
# GramSetu — Environment Configuration
# ================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# ================================================================
# MongoDB Atlas Database Configuration
# ================================================================
# To connect to your cloud MongoDB Atlas database:
# 1. Sign in to https://cloud.mongodb.com
# 2. Go to "Database" -> click "Connect" on your cluster
# 3. Choose "Drivers" (Node.js)
# 4. Copy the connection string and paste below, replacing <username> and <password>
#
# Format:
# MONGODB_URI=mongodb://dbVeeren:<db_password>@ac-fj0e7co-shard-00-00.wti80da.mongodb.net:27017,ac-fj0e7co-shard-00-01.wti80da.mongodb.net:27017,ac-fj0e7co-shard-00-02.wti80da.mongodb.net:27017/?ssl=true&replicaSet=atlas-141344-shard-0&authSource=admin&appName=Cluster0
#
# Note: If MONGODB_URI is left blank, GramSetu automatically initializes
# a built-in MongoDB engine with disk persistence so registration and login
# remain 100% active and persistent out-of-the-box.
MONGODB_URI=mongodb://dbVeeren:<db_password>@ac-fj0e7co-shard-00-00.wti80da.mongodb.net:27017,ac-fj0e7co-shard-00-01.wti80da.mongodb.net:27017,ac-fj0e7co-shard-00-02.wti80da.mongodb.net:27017/?ssl=true&replicaSet=atlas-141344-shard-0&authSource=admin&appName=Cluster0

# ================================================================
# Security & Authentication
# ================================================================
# Secret key used for signing JSON Web Tokens (JWT) for citizen and admin sessions
JWT_SECRET=gramsetu_secure_jwt_secret_key_change_in_production_2026

# Master password for Panchayat Administrative Portal
ADMIN_PASSWORD=GramSetu@2026

# ================================================================
# Cloudinary CDN Configuration (Optional: For Grievance Photo Proofs)
# ================================================================
# Obtain from your Cloudinary Console (Dashboard):
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET


